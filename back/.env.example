# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# RAG Configuration (OpenAI Vector Store)
VECTOR_STORE_ID=vs_your_vector_store_id_here
ASSISTANT_ID=  # Optional: 비워두면 자동으로 생성됩니다

# NCPMS (국가농작물병해충관리시스템) API Configuration
NCPMS_API_KEY=your_ncpms_api_key_here

# ESP32 센서 엔드포인트 (실제 센서 데이터 사용 시)
ESP32_ENDPOINT=http://your-esp32-ip:port
